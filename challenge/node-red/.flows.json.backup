    {
        "id": "c359d71313185152",
        "type": "function",
        "z": "f6883eb3583e92ca",
        "name": "random",
        "func": "// Return a random integer from 0 to 30000 (both included):\nvar rand = Math.floor(Math.random() * 30001);\nvar timestamp = Math.floor(msg.payload / 1000); // ms to s\nmsg.payload = { id: rand, timestamp: timestamp};\nreturn msg; // 30001 as random is 1 exclusive\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
