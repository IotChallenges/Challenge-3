    {
        "id": "7909b546c3c62cad",
        "type": "function",
        "z": "f6883eb3583e92ca",
        "name": "prepare thingspeak",
        "func": "let apiKey = \"XAC9SUJ2BSYKUVGS\";\n\nlet costs = flow.get(\"outgoing_costs\") || {};\n\nlet sources = Object.keys(costs);\n\nsources.sort((a, b) => parseInt(a, 16) - parseInt(b, 16));\n\nlet smallestSource = sources[0];\n\nlet destinations = Object.keys(costs[smallestSource]);\n\ndestinations.sort((a, b) => parseInt(a, 16) - parseInt(b, 16));\n\nlet messages = [];\n\nfor (let d of destinations) {\n\n    let cost = costs[smallestSource][d];\n\n    messages.push({\n        url: \"https://api.thingspeak.com/update?api_key=\" + apiKey + \"&field1=\" + cost,\n        payload: {\n            source: smallestSource,\n            destination: d,\n            cost: cost\n        }\n    });\n}\n\nmsg.payload = messages;\n\nreturn msg;",
