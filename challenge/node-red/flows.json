    {
        "id": "05a8298f25358817",
        "type": "function",
        "z": "f6883eb3583e92ca",
        "name": "process link status",
        "func": "let packet = msg.packet;\n\nif (!packet) {\n    return null;\n}\n\nlet sourceRaw = packet[\"Source Address ZigBee\"];\nlet cmd = String(packet[\"Command String\"] || \"\");\n\nif (sourceRaw === undefined || sourceRaw === null || cmd === \"\") {\n    return null;\n}\n\nlet source = \"0x\" + Number(sourceRaw).toString(16);\n\nlet costs = flow.get(\"outgoing_costs\") || {};\n\nif (!costs[source]) {\n    costs[source] = {};\n}\n\nlet regex = /'Address':\\s*'([^']+)'[\\s\\S]*?'Outgoing Cost':\\s*'([^']+)'/g;\nlet match;\n\nwhile ((match = regex.exec(cmd)) !== null) {\n    let destination = match[1];\n    let cost = match[2];\n\n    costs[source][destination] = cost;\n}\n\nflow.set(\"outgoing_costs\", costs);\n\nmsg.payload = costs;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
