    {
        "id": "b089969fcf0e7211",
        "type": "function",
        "z": "f6883eb3583e92ca",
        "name": "build csv costs",
        "func": "let costs = flow.get(\"outgoing_costs\") || {};\n\nlet lines = [\"No.,Source,Destination,Cost\"];\nlet no = 1;\n\nfor (let source in costs) {\n    for (let destination in costs[source]) {\n        lines.push(`${no++},${source},${destination},${costs[source][destination]}`);\n    }\n}\n\nmsg.payload = lines.join(\"\\n\") + \"\\n\";\nreturn msg;",
