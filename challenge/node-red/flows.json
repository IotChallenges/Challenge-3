    {
        "id": "a8e78185f9e4255b",
        "type": "function",
        "z": "f6883eb3583e92ca",
        "name": "get packet n",
        "func": "var n = msg.payload.n;\nvar csv = msg.payload.csv;\n\nif (!n || n.id === undefined || !csv) {\n    return null;\n}\n\nvar id = n.id;\nvar packet = csv[id];\n\nif (!packet) {\n    return null;\n}\n\nvar cmd = String(packet[\"Command String\"] || \"\");\nvar packetType = String(packet[\"Packet Type\"] || \"\");\n\nvar publish = cmd.includes(\"Layer ZBEE_ZCL\");\nvar topic = \"ZigBee/\" + (packet[\"Device Name ZigBee Source\"] || \"unknown\");\nvar ts = Math.floor(Date.now() / 1000);\n\nfunction toHex(value) {\n    if (value === undefined || value === null || value === \"\") {\n        return \"\";\n    }\n    return \"0x\" + Number(value).toString(16);\n}\n\nvar srcAddr = toHex(packet[\"Source Address\"]);\nvar dstAddr = toHex(packet[\"Destination Address\"]);\nvar zbSrcAddr = toHex(packet[\"Source Address ZigBee\"]);\nvar zbDstAddr = toHex(packet[\"Destination Address ZigBee\"]);\n\nmsg.publish = publish;\nmsg.topic = topic;\n\nmsg.payload = {\n    \"timestamp\": ts,\n    \"id\": id,\n    \"wpan.src\": srcAddr,\n    \"wpan.dst\": dstAddr,\n    \"zbee.src\": zbSrcAddr,\n    \"zbee.dst\": zbDstAddr,\n    \"topic\": topic,\n    \"payload\": cmd\n};\n\nmsg.packet = packet;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
