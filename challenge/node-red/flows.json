        "id": "9e9eebc069241918",
        "type": "function",
        "z": "f6883eb3583e92ca",
        "name": "detect link status",
        "func": "let packet = msg.packet;\n\nif (!packet) {\n    return null;\n}\n\nlet packetType = String(packet[\"Packet Type\"] || \"\");\n\nif (packetType === \"Link Status (0x08)\") {\n    return msg;\n}\n\nreturn null;",
