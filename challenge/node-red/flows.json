    {
        "id": "cb2ec725019f8be7",
        "type": "function",
        "z": "f6883eb3583e92ca",
        "name": "filter elems",
        "func": "var cmdString = msg.payload.payload.replaceAll(\"'\", '\"');\nvar cmd = JSON.parse(cmdString);\n\nvar seqNum = cmd[\"Sequence Number\"];\nvar attributes = cmd[\"Attribute\"] || [];\nvar statusList = cmd[\"Status\"] || [];\nvar dataTypes = cmd[\"Data Type\"] || [];\n\nvar int16Val = cmd[\"Int16\"];\nvar uint16Vals = cmd[\"Uint16\"] || [];\n\nvar timestamp = Date.now();\n\n// Incremental row number\ncontext.set(\"rowNum\", context.get(\"rowNum\") || 0);\n\nvar result = [];\n\nfor (var i = 0; i < attributes.length; i++) {\n  var attrName = attributes[i].split(\" (\")[0];\n\n  // Keep only required attributes\n  if (\n    attrName !== \"Active Power\" &&\n    attrName !== \"RMS Current\" &&\n    attrName !== \"RMS Voltage\"\n  ) {\n    continue;\n  }\n  var dataType = dataTypes[i] || \"\";\n  var status = dataTypes[i] || \"\";\n  status = status.split(\" (\")[0];\n  var dataType = dataType.split(\" (\")[0];\n\n  var value = \"\";\n\n  // Active Power uses Int16\n  if (attrName === \"Active Power\") {\n    value = parseInt(int16Val);\n  } else {\n    // RMS Current / RMS Voltage use Uint16 array\n    var uintIndex = 0;\n\n    for (var j = 0; j < i; j++) {\n      if (dataTypes[j] !== undefined && dataTypes[j].includes(\"Unsigned\")) {\n        uintIndex++;\n      }\n    }\n\n    if (uint16Vals[uintIndex]) {\n      value = parseInt(uint16Vals[uintIndex].split(\" \")[0]);\n    }\n  }\n\n  // Increment row number\n  var rowNum = context.get(\"rowNum\") + 1;\n  context.set(\"rowNum\", rowNum);\n\n  // Push object\n  result.push({\n    \"No.\": rowNum,\n    Timestamp: timestamp,\n    \"Sequence Number\": seqNum,\n    Attribute: attrName,\n    Status: status,\n    \"Data Type\": dataType,\n    \"Data Value\": value,\n  });\n}\n\n// Send to CSV node\nmsg.payload = result;\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
